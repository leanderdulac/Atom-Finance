# ATOM — Quantitative Finance Platform

# Copy to backend/.env for local work. Do not use these placeholder values in production.
# Canonical production template: ../.env.example

ATOM_ENV=development

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Placeholders such as "your-secret-key-change-in-production" are rejected.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_HOURS=24

ATOM_DATABASE_URL=postgresql+asyncpg://atom:atom_dev@localhost:5432/atom_dev
REDIS_URL=redis://localhost:6379/0

FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

BRAPI_TOKEN=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=

QUANTMIND_URL=http://127.0.0.1:8010
QUANTMIND_SERVICE_TOKEN=
QUANTMIND_MODEL=gpt-4o-mini

# SEC fair-access User-Agent for Form 4 pulls. Must include a contact email.
# Example: ATOM Research desk@yourdomain.com
ATOM_SEC_USER_AGENT=

# Absolute directory for optional persist=true on /desk/regime/evaluate.
# Leave unset unless you want current-regime.md written to disk.
ATOM_STRATEGY_CONTEXT_DIR=

# 4-hour regime job (Yahoo + FRED). Off in ATOM_ENV=test. Default off unless set.
ATOM_REGIME_JOB=0
ATOM_REGIME_JOB_SECONDS=14400
# If set and the job sees crisis, flatten this owner's open paper trades.
ATOM_REGIME_KILL_OWNER=

# Optional error tracking — leave unset locally, Sentry stays fully disabled.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

ATOM_ALLOW_REGISTRATION=true

# ── Cliente público (Mac + túnel) ─────────────────────────────────
# true: landing e login levam à operação pronta; APIs da mesa ficam
# 403 para quem não é admin/operator.
ATOM_API_HOST=127.0.0.1
ATOM_API_PORT=8000
ATOM_UI_HOST=127.0.0.1
ATOM_UI_PORT=4173
ATOM_VENV=
ATOM_CLIENT_MODE=false
ATOM_CLIENT_JOB=0
ATOM_CLIENT_JOB_SECONDS=300
ATOM_CLIENT_CACHE_TTL=900
ATOM_CLIENT_PAPER_CAPITAL=10000
ATOM_CLIENT_RISK_PCT=1
# Paralelismo interno (uvicorn continua 1 worker — ver runtime.py).
ATOM_COMPUTE_WORKERS=8
ATOM_IO_WORKERS=12
ATOM_DB_POOL_MIN=2
ATOM_DB_POOL_MAX=16
ATOM_TORCH_DEVICE=
# Ollama local. Sem daemon, o «por quê» usa o texto-padrão.
OLLAMA_ENABLED=1
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_AGENT_MODEL=gpt-oss:20b
OLLAMA_TIMEOUT_SECONDS=8
ATOM_AGENT_LLM=ollama
ATOM_AGENT_TIMEOUT=25
XAI_API_KEY=
XAI_MODEL=grok-4.3
ATOM_XAI_MAX_CALLS_PER_HOUR=60
ATOM_XAI_CACHE_TTL=900
ATOM_XAI_TIMEOUT=45
OPENAI_MODEL=gpt-5-mini
ATOM_OPENAI_MAX_CALLS_PER_HOUR=60
ATOM_OPENAI_CACHE_TTL=900
ATOM_OPENAI_TIMEOUT=45
GEMINI_MODEL=gemini-2.5-flash
ATOM_GEMINI_MAX_CALLS_PER_HOUR=60
ATOM_GEMINI_CACHE_TTL=900
ATOM_GEMINI_TIMEOUT=45
# vazio = OpenAI se OPENAI_API_KEY existir, senão Ollama
ATOM_RISK_PROVIDER=
ATOM_SENTIMENT_WEIGHT=0.2
SEARXNG_URL=
BRAVE_API_KEY=
TAVILY_API_KEY=
ATOM_CONTEXT_TIMEOUT=4
ATOM_CONTEXT_TTL=300
ATOM_CONTEXT_JOB=0
ATOM_CONTEXT_JOB_SECONDS=300
ATOM_WORKER_CONTEXT=1
