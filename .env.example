# ════════════════════════════════════════════════════════════════
#  ATOM — Production Environment Template
#  Copy to .env.prod on the server and fill in the values.
#  NEVER commit the actual .env.prod to git.
# ════════════════════════════════════════════════════════════════

ATOM_ENV=production

# ── Security ─────────────────────────────────────────────────────
# ops/macos/install.sh gera um SECRET_KEY se esta linha estiver vazia ou for o placeholder.
# Não imprime o valor. Para gerar à mão: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_GENERATED_KEY
# Short-lived JWT access token (kept only in front-end memory). Default 30 min.
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Long-lived opaque refresh token, carried in an HttpOnly cookie and rotated on
# every refresh. Default 45 days.
REFRESH_TOKEN_EXPIRE_DAYS=45

# ── Storage ───────────────────────────────────────────────────────
# Must point at a managed Postgres instance (DigitalOcean/RDS/Cloud SQL/...).
# Run `alembic upgrade head` (from backend/) against it before first deploy.
ATOM_DATABASE_URL=postgresql+asyncpg://atom:REPLACE_WITH_GENERATED_PASSWORD@REPLACE_WITH_HOST:5432/atom_db
REDIS_URL=redis://redis:6379/0

# ── Domain ────────────────────────────────────────────────────────
FRONTEND_URL=https://atom.yourdomain.com
ALLOWED_ORIGINS=https://atom.yourdomain.com

# ── B3 Market Data ────────────────────────────────────────────────
# Free tier: 15 req/min — https://brapi.dev/register
BRAPI_TOKEN=

# ── AI Providers ──────────────────────────────────────────────────
# At least one is required for the AI Report to function.
ANTHROPIC_API_KEY=      # https://console.anthropic.com
OPENAI_API_KEY=         # https://platform.openai.com
XAI_API_KEY=            # https://x.ai/api
PERPLEXITY_API_KEY=     # https://www.perplexity.ai/settings/api
# Optional additional provider used by the AI provider factory (google-genai).
GOOGLE_API_KEY=

# ── Binance (crypto market data) ──────────────────────────────────
BINANCE_BASE_URL=https://api.binance.com
BINANCE_FUTURES_URL=https://fapi.binance.com
# Read-only public endpoints work without credentials; add keys only if trading.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── B3 Options Data (optional — enriches AI analysis) ─────────────
BRIDGEWISE_TOKEN=       # https://bridgewise.com/integrations
BRIDGEWISE_BASE_URL=https://rest.bridgewise.com

# QuantMind research worker (separate Python environment)
QUANTMIND_URL=http://127.0.0.1:8010
QUANTMIND_SERVICE_TOKEN=
QUANTMIND_MODEL=gpt-4o-mini

# Read-only options providers. Credentials remain on backend only.
# Restricted to the configured ATOM username; no implicit redistribution.
OPLAB_ACCESS_TOKEN=
OPLAB_OWNER=
# Cookie header from an authorized Cedro WebFeeder session (expires upstream).
CEDRO_SESSION_COOKIE=
CEDRO_OWNER=

# Production pilot: single worker (see app/core/runtime.py — the crash-
# recovery logic isn't yet safe for multiple workers/replicas).
# SEC fair-access User-Agent for Form 4 pulls. Must include a contact email.
ATOM_SEC_USER_AGENT=

ATOM_ALLOW_REGISTRATION=false

# ── Cliente público no Mac (túnel Cloudflare) ─────────────────────
# Host/porta do FastAPI. Default loopback — o público entra pelo túnel.
# Se 8000 já estiver ocupada neste Mac, mude ATOM_API_PORT.
ATOM_API_HOST=127.0.0.1
ATOM_API_PORT=8000
ATOM_UI_HOST=127.0.0.1
ATOM_UI_PORT=4173
# Vazio = backend/venv. Aponta para um .venv já pronto se não quiser recriar.
ATOM_VENV=
ATOM_PUBLIC_URL=
ATOM_CLIENT_MODE=true
# 0 no uvicorn quando o worker launchd (com.atom.worker) segura os timers.
ATOM_CLIENT_JOB=0
ATOM_CLIENT_JOB_SECONDS=300
ATOM_CLIENT_CACHE_TTL=900
ATOM_CLIENT_PAPER_CAPITAL=10000
ATOM_CLIENT_RISK_PCT=1
ATOM_COMPUTE_WORKERS=8
ATOM_IO_WORKERS=12
ATOM_DB_POOL_MIN=4
ATOM_DB_POOL_MAX=16
ATOM_TORCH_DEVICE=mps
OLLAMA_ENABLED=1
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_AGENT_MODEL=gpt-oss:20b
OLLAMA_TIMEOUT_SECONDS=8
# Agentes de contexto: ollama (padrão). Cloud só com chave + ATOM_AGENT_LLM.
ATOM_AGENT_LLM=ollama
ATOM_AGENT_TIMEOUT=25
# xAI / Grok — a chave vive só no .env local (NÃO commitar).
# Se XAI_API_KEY existir, o agente de notícias usa POST /v1/responses
# com web_search + x_search (docs.x.ai). Ollama fica de fallback.
# Risco (advogado do diabo) continua Ollama salvo ATOM_RISK_PROVIDER=xai.
XAI_API_KEY=
XAI_MODEL=grok-4.3
# reasoning opcional: XAI_MODEL=grok-4.20-0309-reasoning
ATOM_XAI_MAX_CALLS_PER_HOUR=60
ATOM_XAI_CACHE_TTL=900
ATOM_XAI_TIMEOUT=45
ATOM_RISK_PROVIDER=ollama
# Termômetro: peso na direção/confiança. Só sobe com evidência (GET /api/desk/sentiment-skill).
ATOM_SENTIMENT_WEIGHT=0.2
# Busca. Vazio = provedor desligado. SearXNG: docker compose -f docker-compose.searxng.yml up -d
SEARXNG_URL=
BRAVE_API_KEY=
TAVILY_API_KEY=
ATOM_SEARXNG=0
ATOM_CONTEXT_TIMEOUT=4
ATOM_CONTEXT_TTL=300
ATOM_CONTEXT_JOB=0
ATOM_CONTEXT_JOB_SECONDS=300
ATOM_WORKER_CONTEXT=1
CLOUDFLARE_TUNNEL_TOKEN=
# Backstop cap on request body bytes (413 above this). Reverse proxies should
# enforce client_max_body_size first; this guards a directly-exposed backend.
ATOM_MAX_BODY_BYTES=5242880
# NOTE: ATOM_BIND_ADDRESS / ATOM_HTTP_PORT are consumed ONLY by
# docker-compose.prod.yml (host port mapping). The app binds via uvicorn flags
# (hardcoded 0.0.0.0:8000 in the compose), so these two do not change the app.
ATOM_BIND_ADDRESS=127.0.0.1
ATOM_HTTP_PORT=8080

# ── Regime 4h job (optional) ────────────────────────────────────────
# Run the live-regime loop at startup (1) or not (0). ATOM_REGIME_KILL_OWNER,
# when set, flattens that user's open paper trades on a crisis regime.
ATOM_REGIME_JOB=0
ATOM_REGIME_JOB_SECONDS=14400
ATOM_REGIME_KILL_OWNER=

# Directory where regime job persists the strategy-context markdown files.
# Required for POST /api/desk/regime/...?persist=true — absolute path only.
ATOM_STRATEGY_CONTEXT_DIR=

# Trust X-Forwarded-For for per-client rate limiting. ONLY enable when /api is
# reachable exclusively through the frontend nginx (it is, in docker-compose.prod).
# Do NOT enable on a directly-exposed backend (clients could spoof the header).
ATOM_TRUST_X_FORWARDED_FOR=0

# ── Observability (optional) ───────────────────────────────────────
# Error tracking. Leave SENTRY_DSN empty to disable — nothing else in the
# app depends on it. Traces are off by default (0.0); this is error capture,
# not performance monitoring, at pilot scale.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
# /api/metrics (Prometheus). Fail-closed by default: it requires a JWT. Set to
# true ONLY when the metrics port sits on a trusted network (in the prod
# compose the backend container is internal-only, so a scraper can reach it).
ATOM_METRICS_PUBLIC=false

# HTTPS overlay (pass ATOM_ENABLE_EDGE=true to scripts/deploy.sh explicitly).
# ATOM_DOMAIN=atom.example.com

# Read-only US stock/options quotes (OpenBB-style connector)
TRADIER_ACCESS_TOKEN=
TRADIER_OWNER=
TRADIER_ENV=sandbox
