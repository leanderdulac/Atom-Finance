APP_DIR=/opt/atom
ATOM_RELEASE_DIR=/opt/atom
PROD_ENV=/opt/atom/.env.prod
ATOM_OPS_STATE=/var/lib/atom-ops
ATOM_DISK_PATH=/var/lib/docker
ATOM_HEALTH_URL=http://127.0.0.1:8080/api/health
# Initialize the repository explicitly with restic init before enabling the timer.
RESTIC_REPOSITORY=s3:https://REGION.digitaloceanspaces.com/BUCKET/atom
RESTIC_PASSWORD_FILE=/etc/atom/restic-password
AWS_ACCESS_KEY_ID=REPLACE_ON_SERVER
AWS_SECRET_ACCESS_KEY=REPLACE_ON_SERVER
